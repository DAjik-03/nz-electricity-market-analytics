let
    Rows = if ReleaseGate then Value.NativeQuery(Source, "WITH flags AS (#(lf) SELECT interval_id,min(start_utc) AS start_utc,max(end_utc) AS end_utc,#(lf) count(*) FILTER(WHERE is_price_pressure)::int AS zones_flagged#(lf) FROM analytics.mart_market_interval_zone#(lf) WHERE zone IN ('CNI','LNI','LSI','UNI','USI') GROUP BY interval_id#(lf)), marked AS (#(lf) SELECT *,CASE WHEN lag(end_utc) OVER(ORDER BY start_utc)=start_utc THEN 0 ELSE 1 END AS begins#(lf) FROM flags WHERE zones_flagged>0#(lf)), episodes AS (#(lf) SELECT interval_id,sum(begins) OVER(ORDER BY start_utc)::bigint AS episode_id FROM marked#(lf))#(lf)SELECT f.interval_id,f.zones_flagged,e.episode_id,#(lf) f.zones_flagged>0 AND NOT n.is_price_pressure AS zone_only#(lf)FROM flags f LEFT JOIN episodes e USING(interval_id)#(lf)JOIN analytics.mart_market_interval_national n USING(interval_id)", null, [EnableFolding=false]) else error "Release gate failed"
in Rows
