#table(type table [case_id=text, event_id=text, selection_reason=text, publisher=text, title=text, url=text, locator=text, supported_context=text, qualification=text, review_date=text], {
  {"E1", "National:National:202608040730", "Highest-peak National event with all five Zones flagged throughout", "Electricity Authority", "Trading conduct report 2-8 August 2026", "https://www.ea.govt.nz/documents/10708/Trading_conduct_report_02-08_August_2026_1.pdf", "Sections 2.3-2.4, 7.11, 7.17, 7.20; printed pages 1, 9-11", "EA connects the Tuesday evening high prices with thermal availability problems and reports an earlier reserve and wind forecast shortfall. It also reports that Ruakaka was depleted during the evening high-price periods.", "Relevant contemporaneous context for the selected evening, not a causal estimate from this project's data. Node/dispatch prices differ from Offtake-weighted National half-hours. The report's sections give inconsistent Huntly trip timing; do not assert an exact trip time. Storage output here is not state of charge.", "2026-10-02"},
  {"E2", "National:National:202509051930", "Longest National event; earliest start breaks ties", "Electricity Authority", "Trading conduct report 31 August-6 September 2025", "https://www.ea.govt.nz/documents/8360/Trading_Conduct_Report_31_Aug_-_6_Sept_2025.pdf", "Sections 7.3 and 7.9; printed pages 6 and 8", "EA describes declining Saturday wind and dispatch of thermal peakers in low-wind conditions.", "Day-level corroborating context, not proof of the cause of the entire selected morning event. The project does not contain wind forecasts, offers or dispatch counterfactuals.", "2026-10-02"},
  {"E3", "Zone:CNI:202603021830", "Largest maximum spread among Zone events with no National flagged interval", "Electricity Authority", "Trading conduct report 1-7 March 2026", "https://www.ea.govt.nz/documents/9432/Trading_conduct_report_-_1_March_2026.pdf", "Sections 2.4-2.5; printed page 1", "EA attributes Tuesday and Wednesday morning Fernhill and Tuai node spikes to Hawke's Bay line constraints, with further monitoring indicated.", "Official node-level context consistent with investigating the CNI separation. No node-to-Zone contribution decomposition was performed; do not claim the entire Zone spread was caused by this constraint.", "2026-10-02"},
  {"E4", "National:National:202608040630", "Highest-peak isolated National half-hour", "Electricity Authority", "Trading conduct report 2-8 August 2026", "https://www.ea.govt.nz/documents/10708/Trading_conduct_report_02-08_August_2026_1.pdf", "Sections 2.3-2.4, 7.11, 7.17, 7.20; printed pages 1, 9-11", "EA connects the Tuesday evening high prices with thermal availability problems and reports an earlier reserve and wind forecast shortfall. It also reports that Ruakaka was depleted during the evening high-price periods.", "Relevant contemporaneous context for the selected evening, not a causal estimate from this project's data. Node/dispatch prices differ from Offtake-weighted National half-hours. The report's sections give inconsistent Huntly trip timing; do not assert an exact trip time. Storage output here is not state of charge.", "2026-10-02"},
  {"E5", "National:National:202603291430", "Lowest mean-demand National event: counterexample to high-demand-only interpretation", "Electricity Authority", "Trading conduct report 29 March-4 April 2026", "https://www.ea.govt.nz/documents/9576/Trading_conduct_report_-_29_March_2026.pdf", "Sections 2.5 and 7.8-7.11; printed pages 1 and 7", "EA discusses forecast differences around some Monday high prices.", "No exact attribution to the selected 03:30 half-hour was established from the reviewed text. Retain the event as a descriptive counterexample with its cause unresolved.", "2026-10-02"}
})
