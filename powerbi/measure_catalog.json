[
  {
    "name": "Weighted Wholesale Price",
    "expression": "DIVIDE(SUM(FactNational[price_numerator]), SUM(FactNational[priced_offtake_kwh]))",
    "display_folder": "Price\\National",
    "format_string": "#,0.00",
    "description": "NZD/MWh; ratio of sums, never average weighted prices.",
    "home_table": "FactNational"
  },
  {
    "name": "P95 Price",
    "expression": "IF(COUNTROWS(FILTER(FactNational, NOT ISBLANK(FactNational[weighted_price])))>0, PERCENTILEX.INC(FILTER(FactNational, NOT ISBLANK(FactNational[weighted_price])), FactNational[weighted_price], 0.95))",
    "display_folder": "Price\\National",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Price Volatility",
    "expression": "VAR N=COUNTROWS(FILTER(FactNational, NOT ISBLANK(FactNational[weighted_price]))) RETURN IF(N=1,0,IF(N>1,STDEVX.P(FILTER(FactNational, NOT ISBLANK(FactNational[weighted_price])),FactNational[weighted_price])))",
    "display_folder": "Price\\National",
    "format_string": "#,0.00",
    "description": "Population SD of half-hour weighted prices; blanks excluded; one observation = 0.",
    "home_table": "FactNational"
  },
  {
    "name": "Total Demand GWh",
    "expression": "DIVIDE(SUM(FactNational[offtake_kwh]),1000000)",
    "display_folder": "Demand\\National",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
  {
