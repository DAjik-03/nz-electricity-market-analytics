  },
  {
    "name": "Zone Flagged Half-hours",
    "expression": "IF(HASONEVALUE(DimZone[zone]), IF(NOT ISBLANK([Zone Full-period P99 threshold]),IF(COUNTROWS(FactZone)>0,COALESCE(COUNTROWS(FILTER(FactZone,FactZone[is_price_pressure]=TRUE())),0))))",
    "display_folder": "Price Pressure\\Zone",
    "format_string": "#,0",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Zone Pressure Hours",
    "expression": "IF(HASONEVALUE(DimZone[zone]), 0.5*[Zone Flagged Half-hours])",
    "display_folder": "Price Pressure\\Zone",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Full-period P99 threshold",
    "expression": "CALCULATE(MAX(Threshold[p99_price]),REMOVEFILTERS(Threshold),Threshold[scope]=\"National\")",
    "display_folder": "Price Pressure",
    "format_string": "#,0.00",
    "description": "Full release; disconnected from Date. Not an official scarcity threshold.",
    "home_table": "FactNational"
  },
  {
    "name": "Zone Full-period P99 threshold",
    "expression": "VAR Z=SELECTEDVALUE(DimZone[zone]) RETURN IF(HASONEVALUE(DimZone[zone]),CALCULATE(MAX(Threshold[p99_price]),REMOVEFILTERS(Threshold),Threshold[scope]=\"Zone\",Threshold[zone]=Z))",
    "display_folder": "Price Pressure",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
