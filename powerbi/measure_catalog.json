    "display_folder": "Coverage and Data Quality\\National",
    "format_string": "0.00%",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Flagged Half-hours",
    "expression": "IF(COUNTROWS(FactNational)>0,COALESCE(COUNTROWS(FILTER(FactNational,FactNational[is_price_pressure]=TRUE())),0))",
    "display_folder": "Price Pressure\\National",
    "format_string": "#,0",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Pressure Hours",
    "expression": "0.5*[Flagged Half-hours]",
