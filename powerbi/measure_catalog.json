  },
  {
    "name": "Peak Demand MW",
    "expression": "MAX(FactNational[demand_mw])",
    "display_folder": "Demand\\National",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Mean Demand MW",
    "expression": "AVERAGE(FactNational[demand_mw])",
    "display_folder": "Demand\\National",
    "format_string": "#,0.00",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Renewable Primary Share",
    "expression": "DIVIDE(SUM(FactNational[renewable_kwh]),SUM(FactNational[renewable_kwh])+SUM(FactNational[fossil_kwh]))",
    "display_folder": "Generation\\National",
    "format_string": "0.00%",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Fossil Thermal Share",
    "expression": "DIVIDE(SUM(FactNational[fossil_kwh]),SUM(FactNational[renewable_kwh])+SUM(FactNational[fossil_kwh]))",
    "display_folder": "Generation\\National",
    "format_string": "0.00%",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Classification Coverage",
    "expression": "DIVIDE(SUM(FactNational[generation_kwh])-SUM(FactNational[unclassified_kwh]),SUM(FactNational[generation_kwh]))",
    "display_folder": "Coverage and Data Quality\\National",
    "format_string": "0.00%",
    "description": "",
    "home_table": "FactNational"
  },
  {
    "name": "Offtake Zone Coverage",
