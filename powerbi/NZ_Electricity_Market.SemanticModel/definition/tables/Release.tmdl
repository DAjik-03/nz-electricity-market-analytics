		summarizeBy: none
		sourceColumn: refresh_id

	column input_fingerprint
		dataType: string
		lineageTag: 0822ed73-d143-59ca-a9ab-d4cc2f090c40
		summarizeBy: none
		sourceColumn: input_fingerprint

	column dq_run_id
		dataType: int64
		formatString: 0
		lineageTag: 31536f7c-8f03-5080-8dca-0301c42e2ee4
		summarizeBy: none
		sourceColumn: dq_run_id

	column dq_as_of_date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 09aaa15e-e582-595a-abeb-31200614dbaf
		summarizeBy: none
		sourceColumn: dq_as_of_date

	column dq_status
		dataType: string
		lineageTag: 3b055b1a-8d8f-5572-8c2a-4b84c711e56d
